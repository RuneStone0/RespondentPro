# ── Data store ────────────────────────────────────────────
# "local"   (default) — JSON files stored in data/
# "mongodb" — requires MONGODB_URI below
# DATA_STORE_MODE=local

# Required when DATA_STORE_MODE=mongodb
# MONGODB_URI=mongodb://user:pass@host:27017/respondentpro

# ── AI keyword suggestions ────────────────────────────────
# The active AI provider and API keys can be set via the app UI
# (Settings → AI provider). They are stored in the data store
# and never need to go in this file.
#
# The one exception is the Anthropic key, which can optionally
# be pre-loaded from the environment at startup:
# ANTHROPIC_API_KEY=sk-ant-...
#
# Supported providers (configured in-app): Anthropic, GPT-4o, Grok

# ── Security note ─────────────────────────────────────────
# Do NOT put RESPONDENT_COOKIE here.
# Your session cookie is a live auth token — set it via the
# cookie modal in the app UI. It is stored in the data store
# (data/config.json or MongoDB) and is never committed to git.
#
# To activate: copy this file to .env and uncomment what you need.
#   cp env.example .env

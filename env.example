# ── Data store ────────────────────────────────────────────
# "local"   — JSON files stored in data/
# "mongodb" — requires MONGODB_URI below
#
# If DATA_STORE_MODE is omitted but MONGODB_URI is set, MongoDB is used automatically.
# DATA_STORE_MODE=local

# Required for MongoDB (also auto-selects the store when DATA_STORE_MODE is unset)
# MONGODB_URI=mongodb://user:pass@host:27017/respondentpro

# ── AI keyword suggestions ────────────────────────────────
# Set the active provider and its API key at startup (12-factor style).
# Both vars must be set together; if omitted the values stored in the
# data store (set via the app UI) are used instead.
#
# Supported providers: anthropic, grok
# (and the GPT-4o provider — see app UI)
#
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...

# ── Security note ─────────────────────────────────────────
# Do NOT put RESPONDENT_COOKIE here.
# Your session cookie is a live auth token — set it via the
# cookie modal in the app UI. It is stored in the data store
# (data/config.json or MongoDB) and is never committed to git.
#
# To activate: copy this file to .env and uncomment what you need.
#   cp env.example .env
